Comment: 0,0:02:24.17,0:02:27.17,_purple_,,0,0,0,code once,easings = {["easeOutBack"] = easeOutBack, ["easeInOutQuart"] = easeInOutQuart, ["easeInOutExpo"] = easeInOutExpo, ["easeOutCubic"] = easeOutCubic, ["easeInOutCirc"] = easeInOutCirc, ["easeInOutQuad"] = easeInOutQuad, ["easeInQuad"] = easeInQuad, ["easeOutQuad"] = easeOutQuad, ["easeInOutCubic"] = easeInOutCubic, ["easeInCubic"] = easeInCubic}
Comment: 0,0:02:24.17,0:02:27.17,_purple_,,0,0,0,code once,function easeTag(tag, easing, start_val, end_val, start_time, end_time, no_start_tag)	local easing = easings[easing];	local t = start_time;	local out = ""	if (not no_start_tag) then		out = out .. "\\" .. tag .. start_val;	end;	while (t < end_time) do            	local t_plus = math.floor(t + fbf_sr);        local x = remap(t_plus, start_time, end_time, 0, 1, true);        local tagval = remap(easing(x),0,1,start_val,end_val);        out = out .. "\\t(" .. t .. "," .. t_plus .. ",1,\\" .. tag .. tagval .. ")";        t = t_plus + 1;    end;	out = out .. "\\t(" .. t .. "," .. t+1 .. ",1,\\" .. tag .. end_val .. ")";	return out;end;
Comment: 0,0:02:27.17,0:02:27.17,_purple_,,0,0,0,code once,function easeTagAlpha(tag, easing, start_val, end_val, start_time, end_time, no_start_tag)	local easing = easings[easing];	local t = start_time;	local out = ""	if (not no_start_tag) then		out = out .. "\\" .. tag .. "&H" .. string.format("%02x", start_val) .. "&";	end;	while (t < end_time) do            	local t_plus = math.floor(t + fbf_sr);        local x = remap(t_plus, start_time, end_time, 0, 1, true);        local tagval = remap(easing(x),0,1,start_val,end_val);        out = out .. "\\t(" .. t .. "," .. t_plus .. ",1,\\" .. tag .. "&H" .. string.format("%02x", tagval) .. "&" .. ")";        t = t_plus + 1;    end;	out = out .. "\\t(" .. t .. "," .. t+1 .. ",1,\\" .. tag .. "&H" .. string.format("%02x", end_val) .. "&" .. ")";	return out;end;
Comment: 0,0:02:27.88,0:02:30.88,_purple_,,0,0,0,code once,function easeTagXY(tag, easing, start_x, start_y, end_x, end_y, start_time, end_time, no_start_tag)	local easing = easings[easing];	local t = start_time;	local out = ""	if (not no_start_tag) then		out = "\\" .. tag .. "(" .. start_x .. "," .. start_y .. ")";	end;	while (t < end_time) do            	local t_plus = math.floor(t + fbf_sr);        local x = remap(t_plus, start_time, end_time, 0, 1, true);        local tagvalx = remap(easing(x),0,1,start_x,end_x);        local tagvaly = remap(easing(x),0,1,start_y,end_y);        out = out .. "\\t(" .. t .. "," .. t_plus .. ",1,\\" .. tag .. "(" .. tagvalx .. "," .. tagvaly .. "))";        t = t_plus + 1;    end;    out = out .. "\\t(" .. t .. "," .. t+1 .. ",1,\\" .. tag .. "(" .. end_x .. "," .. end_y .. "))";	return out;end;
