Comment: 0,0:01:40.16,0:01:40.16,_terra_,,0,0,0,code once,_ = "I like global variables";function rotateIn()    local t = 0;    local end_t = rot_in_e;    local out = "\\frz" .. trans_rot .. "\\fscx" .. trans_scalex .. "\\fscy" .. trans_scaley;    while (t < end_t) do        local t_plus = math.floor(t + fbf_sr);        local x = remap(t, 0, end_t, 0, 1, true);        local frz = remap(easeOutBack(x),0,1,trans_rot,0);        local fax = remap(easeOutBack(x),0,1,trans_xshear,xshear);        local fay = remap(easeOutBack(x),0,1,trans_yshear,yshear);        local fscx = remap(easeOutBack(x),0,1,trans_scalex,100);        local fscy = remap(easeOutBack(x),0,1,trans_scaley,100);        out = out .. "\\t(" .. t .. "," .. t_plus .. ",1,\\frz" .. frz .. ")";        out = out .. "\\t(" .. t .. "," .. t_plus .. ",1,\\fscx" .. fscx .. ")";        out = out .. "\\t(" .. t .. "," .. t_plus .. ",1,\\fscy" .. fscy .. ")";        t = t_plus + 1;    end;    out = out .. "\\t(" .. t .. "," .. t+1 .. ",1,\\frz0)";    out = out .. "\\t(" .. t .. "," .. t+1 .. ",1,\\fscx" .. 100 .. ")";    out = out .. "\\t(" .. t .. "," .. t+1 .. ",1,\\fscy" .. 100 .. ")";    return out;end;
Comment: 0,0:01:40.16,0:01:40.16,_terra_,,0,0,0,code once,_ = "I like global variables";function rotateInBord()    local t = 0;    local end_t = rot_in_e;    local out = "\\frz" .. trans_rot .. "\\fscx" .. trans_scalex .. "\\fscy" .. trans_scaley .. "\\xbord" .. (trans_scalex/100)*bord_size .. "\\ybord" .. (trans_scaley/100)*bord_size;    while (t < end_t) do        local t_plus = math.floor(t + fbf_sr);        local x = remap(t, 0, end_t, 0, 1, true);        local frz = remap(easeOutBack(x),0,1,trans_rot,0);        local fax = remap(easeOutBack(x),0,1,trans_xshear,xshear);        local fay = remap(easeOutBack(x),0,1,trans_yshear,yshear);        local fscx = remap(easeOutBack(x),0,1,trans_scalex,100);        local fscy = remap(easeOutBack(x),0,1,trans_scaley,100);        out = out .. "\\t(" .. t .. "," .. t_plus .. ",1,\\frz" .. frz .. ")";        out = out .. "\\t(" .. t .. "," .. t_plus .. ",1,\\fscx" .. fscx .. ")";        out = out .. "\\t(" .. t .. "," .. t_plus .. ",1,\\fscy" .. fscy .. ")";        out = out .. "\\t(" .. t .. "," .. t_plus .. ",1,\\xbord" .. (fscx/100)*bord_size .. ")";        out = out .. "\\t(" .. t .. "," .. t_plus .. ",1,\\ybord" .. (fscy/100)*bord_size .. ")";        t = t_plus + 1;    end;    out = out .. "\\t(" .. t .. "," .. t+1 .. ",1,\\frz0)";    out = out .. "\\t(" .. t .. "," .. t+1 .. ",1,\\fscx" .. 100 .. ")";    out = out .. "\\t(" .. t .. "," .. t+1 .. ",1,\\fscy" .. 100 .. ")";    out = out .. "\\t(" .. t .. "," .. t+1 .. ",1,\\xbord" .. bord_size .. ")";    out = out .. "\\t(" .. t .. "," .. t+1 .. ",1,\\ybord" .. bord_size .. ")";    return out;end;
Comment: 0,0:01:40.16,0:01:43.16,_terra_,,0,0,0,code once,function shadowOut(targ_x, targ_y)	local t = shadow_s;    local end_t = shadow_e;	local out = "\\xshad0\\yshad0";	while (t < end_t) do            	local t_plus = math.floor(t + fbf_sr);        local x = remap(t, 0, end_t, 0, 1, true);        local xshad = remap(easeInOutQuart(x),0,1,0,targ_x);        local yshad = remap(easeInOutQuart(x),0,1,0,targ_y);        out = out .. "\\t(" .. t .. "," .. t_plus .. ",1,\\xshad" .. xshad .. ")";        out = out .. "\\t(" .. t .. "," .. t_plus .. ",1,\\yshad" .. yshad .. ")";        t = t_plus + 1;    end;	out = out .. "\\t(" .. t .. "," .. t+1 .. ",1,\\xshad" .. targ_x .. ")";    out = out .. "\\t(" .. t .. "," .. t+1 .. ",1,\\yshad" .. targ_y .. ")";    return out;end;
