Comment: 0,0:01:37.28,0:01:40.16,_terra_,,0,0,0,code once,function easeOutBack(x) local c1 = 1.70158; local c3 = c1+1; return 1 + c3 * math.pow(x - 1, 3) + c1 * math.pow(x - 1, 2); end;
Comment: 0,0:01:38.99,0:01:41.99,_terra_,,0,0,0,code once,function easeInOutQuart(x) return x < 0.5 and 8 * x * x * x * x or 1 - math.pow(-2 * x + 2, 4) / 2; end;
Comment: 0,0:01:45.46,0:01:48.46,_terra_,,0,0,0,code once,function easeInOutExpo(x) return x == 0 and 0 or x == 1 and 1 or x < 0.5 and math.pow(2, 20 * x - 10) / 2 or (2 - math.pow(2, -20 * x + 10)) / 2; end;
