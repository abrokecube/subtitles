Comment: 0,0:02:24.08,0:02:24.08,_purple_,,0,0,0,code once,function easeInOutCirc(x) return x < 0.5 and (1 - math.sqrt(1 - math.pow(2 * x, 2))) / 2 or (math.sqrt(1 - math.pow(-2 * x + 2, 2)) + 1) / 2 end;
Comment: 0,0:02:26.71,0:02:29.71,_purple_,,0,0,0,code once,function easeInOutCubic(x) return x < 0.5 and 4 * x * x * x or 1 - math.pow(-2 * x + 2, 3) / 2 end;
Comment: 0,0:02:26.75,0:02:29.75,_purple_,,0,0,0,code once,function easeInOutQuad(x) return x < 0.5 and 2 * x * x or 1 - math.pow(-2 * x + 2, 2) / 2; end;
Comment: 0,0:02:26.75,0:02:29.75,_purple_,,0,0,0,code once,function easeInCubic(x) return x * x * x end;
Comment: 0,0:02:29.75,0:02:30.46,_purple_,,0,0,0,code once,function easeInQuad(x) return x * x; end;
Comment: 0,0:02:29.75,0:02:30.46,_purple_,,0,0,0,code once,function easeOutQuad(x) return 1 - (1 - x) * (1 - x); end;
